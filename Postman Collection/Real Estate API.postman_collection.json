				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"",
									"let token;",
									"try {",
									"  const body = pm.response.json();",
									"  token = body?.data?.accessToken",
									"       || body?.accessToken              // por si viene sin \"data\"",
									"       || body?.result?.accessToken;     // variantes comunes",
									"  const expiresUtc = body?.data?.expiresAtUtc || body?.expiresAtUtc;",
									"  if (expiresUtc) pm.environment.set(\"tokenExpires\", expiresUtc);",
									"} catch (e) {",
									"",
									"}",
									"",
									"if (!token) {",
									"  const authHeader = pm.response.headers.get(\"Authorization\");",
									"  if (authHeader && authHeader.startsWith(\"Bearer \")) {",
									"    token = authHeader.slice(7);",
									"  }",
									"}",
									"",
									"if (!token) {",
									"  const text = pm.response.text();",
									"  const m = text.match(/[\\w-]+\\.[\\w-]+\\.[\\w-]+/);",
									"  if (m) token = m[0];",
									"}",
									"",
									"if (token) {",
									"  pm.environment.set(\"token\", token);",
									"  pm.test(\"Saved access token to {{token}}\", () => {",
									"    pm.expect(pm.environment.get(\"token\")).to.eql(token);",
									"  });",
									"} else {",
									"  pm.test(\"Access token not found\", () => {",
									"    pm.expect.fail(\"Could not find access token in response\");",
									"  });",
									"}",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
